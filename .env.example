# Fast model for ordinary and high-volume tasks
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=
DEEPSEEK_MODEL=deepseek-v4-flash

# High-reasoning model for critical or complex tasks
RELAY_API_KEY=
RELAY_BASE_URL=
GPT_MODEL_NAME=gpt-5.5

# Embedding provider
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=
SILICONFLOW_EMBEDDING_MODEL=BAAI/bge-m3
SILICONFLOW_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
EMBEDDING_DIMENSION=1024

# Local Qdrant is used when QDRANT_URL is empty.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_PATH=data/qdrant
QDRANT_COLLECTION=agent_seed_v3_bge_m3_chunking_v1

# Base RAG settings
CHUNKING_VERSION=chunking_v1
CHUNK_SIZE_CHARS=3200
CHUNK_OVERLAP_CHARS=400
RETRIEVAL_TOP_K=5
ANSWER_MAX_TOKENS=2400

# Bounded LangGraph Agent Runtime
AGENT_PLANNER_MAX_TOKENS=1800
AGENT_TOP_K=10
AGENT_CANDIDATE_POOL_PER_TASK=30
AGENT_MAX_RETRIES=1
AGENT_MIN_CHUNKS_PER_TASK=2
AGENT_CLAIM_VERIFICATION_ENABLED=true
AGENT_CLAIM_VERIFIER_MAX_TOKENS=2400

# Optional observability
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=paper-research-copilot

# Application
APP_ENV=development
LOG_LEVEL=INFO
APP_DATABASE_PATH=data/app.db
CHECKPOINT_DATABASE_PATH=data/checkpoints.db
ARXIV_API_URL=https://export.arxiv.org/api/query
DYNAMIC_ASSETS_PATH=data/dynamic/papers
DYNAMIC_QDRANT_PATH=data/qdrant_dynamic
DYNAMIC_QDRANT_COLLECTION=paper_dynamic_bge_m3_chunking_v1
ACQUISITION_CANDIDATES_PER_QUERY=5
ACQUISITION_MAX_DOWNLOADS=2
ACQUISITION_MAX_PDF_BYTES=52428800
ACQUISITION_MAX_DYNAMIC_CHUNKS=500
AGENT_DYNAMIC_ACQUISITION_ENABLED=false
